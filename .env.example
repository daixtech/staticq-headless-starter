# StaticQ Astro starter — local-dev environment template.
#
# Copy this file to `.env` (which is git-ignored), edit the values,
# then run `npm run dev`. The dev server doesn't need real Cloudflare
# bindings — R2 cache writes become no-ops, and the middleware skips
# both cache layers entirely in dev (x-staticq-cache: DEV-NO-CACHE),
# so pages render fresh on every request. If you ever see stale pages
# in dev anyway, delete .wrangler/state — wrangler's local cache
# emulation persists there on disk.
#
# Required: WP_BASE_URL. Everything else has a sane default.

# ─────────────────────────────────────────────────────────────────
# WordPress origin — REQUIRED
# ─────────────────────────────────────────────────────────────────

# Your WP site's home URL. Fetches go to ${WP_BASE_URL}/wp-json/...
# In dev this typically points at your production WP (read-only) or
# a local install:
#   WP_BASE_URL=https://www.example.com
#   WP_BASE_URL=http://mysite.local
WP_BASE_URL=

# Optional shared-secret cookie sent on every WP REST request. Use this
# if your WP origin is behind a Cloudflare WAF (or similar) rule that
# gates Worker traffic — the cookie lets these read-only fetches through.
# Format: "name=value", e.g. WP_FETCH_COOKIE=mygate=secret123
# Leave blank if your WP isn't behind a cookie gate.
WP_FETCH_COOKIE=

# ─────────────────────────────────────────────────────────────────
# Site branding — optional, sensible defaults exist
# ─────────────────────────────────────────────────────────────────

SITE_URL=http://localhost:4321
SITE_TITLE=
SITE_DESCRIPTION=
SITE_LOGO_URL=
SITE_OG_IMAGE_DEFAULT=
SITE_TWITTER_HANDLE=

# Set to "false" for staging-like behavior (noindex meta + cache
# bypass in middleware). Leave "true" (or unset) for prod-like
# behavior during local dev.
SITE_INDEXABLE=true

# Optional visitor gate cookie. Empty = public. Format: "name=value".
SITE_GATE_COOKIE=

# ─────────────────────────────────────────────────────────────────
# Safety caps — useful for the first dev session against a large
# archive so you don't fan out 7000 fetches before realizing
# something's wrong.
# ─────────────────────────────────────────────────────────────────

# Cap total posts the build will enumerate. 0 = no cap.
MAX_POSTS=0

# Cap categories / tags similarly.
MAX_CATEGORIES=0
MAX_TAGS=0
