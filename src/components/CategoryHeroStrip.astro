---
// Hero strip for LEAF categories under model-shaped roots
// (`models`, `one-offs`, `concepts`).
//
// Each slot maps to a canonical purpose tag (Overview / Guide / Specs /
// Pictures). The route fetches one matching post per slot via
// getCategoryHeroPosts() and passes the result here. Empty slots are
// dropped silently — if no posts match, the whole strip disappears.
//
// Visual treatment is intentionally DIFFERENT from the grid below:
// - "Featured" section label above the strip
// - Image-on-top + text-below cards (not overlay), with a left accent
//   bar so the role label (Overview / Specs / Pictures) reads first
// - Subtle border-bottom separator before the main archive grid
// - Larger title type than the grid cards' overlay text
//
// Rendered only on page 1 of the leaf archive. Hero post IDs are
// excluded from the main grid (and from every paginated page after).

import type { HeroSlot } from '../lib/wp';
import { getResponsiveImage } from '../lib/wp';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
	heroPosts: HeroSlot[];
}

const { heroPosts } = Astro.props;
---

{heroPosts.length > 0 && (
	<section class="cat-featured" aria-label="Featured posts">
		<div class="cat-featured__heading">Featured</div>
		<ul class="cat-featured__list">
			{heroPosts.map((slot) => {
				const image = getResponsiveImage(slot.post, 'medium_large');
				const href = `/${slot.post.slug}/`;
				return (
					<li class="cat-featured__item">
						<a class="cat-featured__link" href={href}>
							<div class="cat-featured__media">
								{image ? (
									<ResponsiveImage
										image={image}
										sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw"
										loading="lazy"
									/>
								) : (
									<span class="cat-featured__placeholder">no image</span>
								)}
							</div>
							<div class="cat-featured__body">
								<span class="cat-featured__role">{slot.label}</span>
								<h3 class="cat-featured__title" set:html={slot.post.title.rendered} />
							</div>
						</a>
					</li>
				);
			})}
		</ul>
	</section>
)}

<style>
	.cat-featured {
		margin: 0 0 2rem;
		padding: 0 0 2rem;
		border-bottom: 1px solid var(--border, #272c33);
	}

	.cat-featured__heading {
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent, #e63946);
		margin: 0 0 1rem;
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.cat-featured__heading::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border, #272c33);
	}

	.cat-featured__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
	}

	@media (min-width: 1100px) {
		.cat-featured__list {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.cat-featured__item {
		margin: 0;
	}

	/* Whole-card link. Distinct visual treatment from the grid below:
	 * background + border instead of image-overlay, plus a left accent
	 * bar that gives the role label visual weight without shouting. */
	.cat-featured__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--bg-elev, #161a1f);
		border: 1px solid var(--border, #272c33);
		border-left: 3px solid var(--accent, #e63946);
		border-radius: var(--radius, 4px);
		overflow: hidden;
		text-decoration: none;
		color: var(--text);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.cat-featured__link:hover,
	.cat-featured__link:focus-visible {
		transform: translateY(-2px);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
		outline: none;
	}

	.cat-featured__media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--bg-elev-2, #1a1d22);
	}

	.cat-featured__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 400ms ease;
	}

	.cat-featured__link:hover .cat-featured__media :global(img),
	.cat-featured__link:focus-visible .cat-featured__media :global(img) {
		transform: scale(1.04);
	}

	.cat-featured__placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted, #6b7280);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.cat-featured__body {
		padding: 0.95rem 1.1rem 1.15rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.cat-featured__role {
		display: inline-block;
		align-self: flex-start;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent, #e63946);
	}

	.cat-featured__title {
		font-size: 1.08rem;
		line-height: 1.3;
		font-weight: 800;
		letter-spacing: -0.005em;
		margin: 0;
		color: var(--text);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.cat-featured__link:hover .cat-featured__title,
	.cat-featured__link:focus-visible .cat-featured__title {
		color: var(--accent-hot, #ff5864);
	}
</style>
